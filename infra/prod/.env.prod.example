# Variables de producción. Copiar a infra/prod/.env.prod (NO se versiona) y completar.
# La API no arranca si quedan valores de desarrollo (ver D21).

ENV=production

# Dominio público (DNS apuntando a este servidor, puertos 80 y 443 abiertos).
SISMO_DOMINIO=sismo.empresa.pe
CORS_ORIGINS=["https://sismo.empresa.pe"]

# Base de datos. Contraseña larga y aleatoria: openssl rand -base64 32
POSTGRES_USER=sismo
POSTGRES_PASSWORD=
POSTGRES_DB=sismo_db

# Firma de sesiones (mínimo 32 caracteres): openssl rand -hex 32
API_SECRET_KEY=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_DEBUG=false
DB_ECHO=false

# Procesos de la API. Con más de 1, el límite de intentos de acceso se cuenta por proceso.
API_WORKERS=1

# Ingesta programada (Celery beat).
INGESTION_INTERVAL_MINUTES=15

# Correo de avisos (desactivado = entregas "simuladas").
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Copias de seguridad: carpeta del servidor, días que se conservan y frecuencia (segundos).
SISMO_BACKUP_DIR=./backups
RETENCION_DIAS=14
BACKUP_INTERVALO_SEG=86400
