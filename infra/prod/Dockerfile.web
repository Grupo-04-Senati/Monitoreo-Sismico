# Imagen de producción del frontend: compila con Vite y lo sirve Caddy, que además
# obtiene el certificado HTTPS y reenvía /api a la API (mismo dominio: cookies seguras).
FROM node:20-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
RUN npm ci
COPY apps/web/ apps/web/
# Datos públicos de la fuente que muestra la interfaz (Docker no copia los .env).
ENV VITE_FUENTE_NOMBRE="USGS"     VITE_FUENTE_ORG="U.S. Geological Survey (Earthquake Hazards Program)"     VITE_FUENTE_URL="https://earthquake.usgs.gov/earthquakes/search/"
RUN npm run build:web

FROM caddy:2.8-alpine
COPY infra/prod/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/apps/web/dist /srv/www
