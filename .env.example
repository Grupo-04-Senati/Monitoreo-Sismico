# ============================================================
# SISTEMA DE MONITOREO SÍSMICO - Variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=sismo
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=sismo_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Imprime cada consulta SQL con sus valores. Solo para depurar en local.
DB_ECHO=false

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_SECRET_KEY=cambiar_clave_secreta_aqui
API_CORS_ORIGINS=http://localhost:5173

# --- Frontend Vite ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Redis (tareas asíncronas) ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Fuentes de datos (ejemplo) ---
IGP_API_URL=https://example-igp-api.pe
INGESTION_INTERVAL_MINUTES=15

# --- Seguridad ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Correo de avisos (SMTP; ver D19) ---
# Desactivado: las entregas por correo quedan "simulada" y no se envía nada.
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# --- SMS de avisos (Twilio; ver D31) ---
# Vacíos: las entregas por SMS quedan "simulada" y no se envía nada. El Auth Token es secreto.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
