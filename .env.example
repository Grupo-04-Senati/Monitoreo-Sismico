# ============================================================
# SISTEMA DE MONITOREO SÍSMICO - Variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# ============================================================

# --- PostgreSQL ---
# Sin Docker (PostgreSQL instalado): POSTGRES_HOST=localhost. Un proveedor (Render, Supabase) entrega una URL
# completa: ponla en DATABASE_URL y tiene prioridad sobre las variables POSTGRES_*.
# DATABASE_URL=
POSTGRES_USER=sismo
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=sismo_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_SECRET_KEY=cambiar_clave_secreta_aqui
# Origenes separados por comas (el codigo lee CORS_ORIGINS)
CORS_ORIGINS=http://localhost:5173
# local | production. Con production la API NO arranca con claves de ejemplo, API_DEBUG=true,
# COOKIE_SECURE=false u origenes http://
ENVIRONMENT=local
COOKIE_SECURE=false

# --- Frontend Vite ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Redis (tareas asíncronas) ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Fuentes de datos (ejemplo) ---
IGP_API_URL=https://example-igp-api.pe
INGESTION_INTERVAL_MINUTES=15

# --- Seguridad ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Alertas (placeholders - configurar en Fase 7) ---
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
