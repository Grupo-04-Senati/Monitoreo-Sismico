# ============================================================
# API (services/api) - variables de entorno de EJEMPLO
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# En Docker el compose fija POSTGRES_HOST=db y REDIS_URL=redis://redis:6379/0.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=sismo
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=sismo_db
# Para ejecutar la API fuera de Docker usa localhost; dentro de Docker usa db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Imprime cada consulta SQL con sus valores (hashes y secretos incluidos).
# Solo para depurar en local; nunca en producción.
DB_ECHO=false

# --- API FastAPI ---
API_DEBUG=true
API_SECRET_KEY=cambiar_clave_secreta_aqui
# Lista JSON de orígenes permitidos para CORS (con credenciales).
CORS_ORIGINS=["http://localhost:5173"]

# --- Sesión / JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Activar en producción (HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Redis (tareas asíncronas) ---
REDIS_URL=redis://localhost:6379/0

# --- Ingesta ---
INGESTION_SOURCE_KEY=igp
INGESTION_INTERVAL_MINUTES=15

# --- Correo de avisos (SMTP) ---
# Desactivado: las entregas por correo quedan "simulada" y no se envía nada.
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# --- Entorno ---
# ENV: development | test | production.
# Con production la API NO arranca si API_SECRET_KEY es la de ejemplo o tiene menos
# de 32 caracteres, COOKIE_SECURE=false, POSTGRES_PASSWORD=sismo_dev, CORS_ORIGINS
# con "*" o localhost, o DB_ECHO=true (ver D21).
ENV=development