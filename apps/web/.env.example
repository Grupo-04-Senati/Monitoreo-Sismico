# ============================================================
# Frontend (apps/web) - variables de entorno de EJEMPLO
# Copiar a .env. NUNCA subir .env al repositorio.
# Solo las variables con prefijo VITE_ quedan expuestas al navegador.
# ============================================================

# Ruta base de la API. Por defecto se usa el proxy de Vite (mismo origen,
# necesario para enviar las cookies HttpOnly de sesión).
VITE_API_BASE_URL=/api/v1

# Origen del backend al que apunta el proxy de Vite en desarrollo.
# Se usa 127.0.0.1 (no "localhost") para evitar que el proxy intente IPv6 (::1)
# mientras uvicorn escucha solo en IPv4.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Fuente de eventos que se muestra en la interfaz (procedencia). Ver docs/DECISIONES.md D15.
VITE_FUENTE_NOMBRE=USGS
VITE_FUENTE_ORG=U.S. Geological Survey (Earthquake Hazards Program)
VITE_FUENTE_URL=https://earthquake.usgs.gov/earthquakes/search/
